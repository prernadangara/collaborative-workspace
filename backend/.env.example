# --- required ---
DATABASE_URL=postgresql://workspace_user:workspace_password@localhost:5432/collaborative_workspace?schema=public
JWT_ACCESS_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string
REDIS_URL=redis://localhost:6379

# --- app ---
PORT=5000
CLIENT_URL=http://localhost:5173

# --- refresh-token cookie ---
# Local / docker (same site):   COOKIE_SECURE=false  COOKIE_SAMESITE=lax
# Vercel -> Render (cross site): COOKIE_SECURE=true   COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
